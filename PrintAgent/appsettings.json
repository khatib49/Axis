{
  "PrintAgent": {
    // SignalR hub the cloud API exposes for print jobs.
    "HubUrl": "https://axisapiwebapp-fvh5e7bda3aag0g7.francecentral-01.azurewebsites.net/hubs/printer",

    // Optional JWT if the hub is later secured with [Authorize]. Leave blank while the hub is anonymous.
    "AccessToken": "",

    // Optional station filter for multi-agent setups. Leave empty for a single agent
    // that drives every printer. To scope one agent to a station, set e.g. "Kitchen"
    // or "Kitchen,Bar" — the agent then ignores jobs for other stations.
    "Stations": "",

    // TCP connect/write timeout (ms) for network printers.
    "NetworkTimeoutMs": 5000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
